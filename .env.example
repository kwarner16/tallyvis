# Tallyvis environment variables
#
# Copy this file to .env.local (for apps/web / apps/app) and fill in real values.
# NEVER commit a file containing real secrets — only .env.example is tracked in git.
#
# Nothing below is consumed by the codebase yet. Each block is reserved for the
# phase that introduces it, so the shape of future configuration is visible now.

# --- Phase 7/8: AI provider abstraction (services/ai) ---
# AI_PROVIDER=mock
# AI_PROVIDER_API_KEY=

# --- Phase 10: Database ---
# DATABASE_URL=

# --- Phase 11: Auth & billing ---
# AUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- General ---
# NODE_ENV=development
